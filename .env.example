# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Port for the local server (optional, defaults to 3000)
PORT=3000

# Shared passcode for the deployed app. Leave this unset locally: with no
# passcode set the gate is inert, which is what you want on your own machine.
# On the server it is set with `fly secrets set`, never in a file.
# Changing it signs everyone out.
# APP_PASSCODE=

# Where the usage log is written (optional, defaults to ./logs). Production
# points this at the mounted volume so the log survives deploys.
# LOG_DIR=/data

# Set to "false" to stop keeping submitted images and critique text on disk.
# The deployed server runs with this off; locally it defaults to on.
# ARCHIVE_ARTEFACTS=true
